<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SLA Policies: Expert Staff First Response -->
        <record id="sla_expert_first_response_urgent" model="dke.sla.policy">
            <field name="name">Expert First Response - Urgent</field>
            <field name="target_type">first_response</field>
            <field name="priority">3</field>
            <field name="max_minutes">15</field>
            <field name="applies_to">expert_staff</field>
        </record>
        <record id="sla_expert_first_response_high" model="dke.sla.policy">
            <field name="name">Expert First Response - High</field>
            <field name="target_type">first_response</field>
