            <field name="max_minutes">4320</field>
            <field name="applies_to">expert_staff</field>
        </record>

        <!-- SLA Policies: Customer Care Chat Response -->
        <record id="sla_care_chat_response" model="dke.sla.policy">
            <field name="name">Customer Care Chat Response</field>
            <field name="target_type">chat_response</field>
            <field name="priority" eval="False"/>
            <field name="max_minutes">5</field>
            <field name="applies_to">customer_care</field>
        </record>
    </data>
</odoo>
