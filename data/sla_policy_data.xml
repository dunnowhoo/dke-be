        <record id="sla_expert_first_response_low" model="dke.sla.policy">
            <field name="name">Expert First Response - Low</field>
            <field name="target_type">first_response</field>
            <field name="priority">0</field>
            <field name="max_minutes">480</field>
            <field name="applies_to">expert_staff</field>
        </record>

        <!-- SLA Policies: Expert Staff Resolution -->
        <record id="sla_expert_resolution_urgent" model="dke.sla.policy">
            <field name="name">Expert Resolution - Urgent</field>
            <field name="target_type">resolution</field>
            <field name="priority">3</field>
            <field name="max_minutes">240</field>
            <field name="applies_to">expert_staff</field>
