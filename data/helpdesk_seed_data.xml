<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Helpdesk Team: DKE Support                                    -->
        <!-- ============================================================ -->
        <record id="helpdesk_team_dke" model="helpdesk.team">
            <field name="name">DKE Support</field>
            <field name="stage_ids" eval="[(6, 0, [
                ref('helpdesk.stage_new'),
                ref('helpdesk.stage_in_progress'),
                ref('helpdesk.stage_on_hold'),
                ref('helpdesk.stage_solved'),
                ref('helpdesk.stage_cancelled'),
            ])]"/>
            <field name="use_sla" eval="True"/>
            <field name="use_rating" eval="True"/>
            <field name="assign_method">randomly</field>
            <field name="color">4</field>
            <field name="description" type="html">
                <p>Tim DKE Support menangani tiket eskalasi dari Customer Care kepada Expert Staff.</p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- SLA Policies                                                  -->
        <!-- ============================================================ -->
        <record id="sla_urgent_2h" model="helpdesk.sla">
            <field name="name">Urgent - 2 Jam</field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="priority">3</field>
            <field name="stage_id" ref="helpdesk.stage_solved"/>
            <field name="time">2</field>
        </record>

        <record id="sla_high_8h" model="helpdesk.sla">
            <field name="name">High - 8 Jam</field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="priority">2</field>
            <field name="stage_id" ref="helpdesk.stage_solved"/>
            <field name="time">8</field>
        </record>

        <record id="sla_normal_24h" model="helpdesk.sla">
            <field name="name">Normal - 24 Jam</field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="priority">0</field>
            <field name="stage_id" ref="helpdesk.stage_solved"/>
            <field name="time">24</field>
        </record>

        <!-- ============================================================ -->
        <!-- Tags                                                          -->
        <!-- ============================================================ -->
        <record id="tag_pembayaran" model="helpdesk.tag">
            <field name="name">Pembayaran</field>
        </record>
        <record id="tag_pengiriman" model="helpdesk.tag">
            <field name="name">Pengiriman</field>
        </record>
        <record id="tag_produk" model="helpdesk.tag">
            <field name="name">Produk</field>
        </record>
        <record id="tag_akun" model="helpdesk.tag">
            <field name="name">Akun</field>
        </record>
        <record id="tag_teknis" model="helpdesk.tag">
            <field name="name">Teknis</field>
        </record>

        <!-- ============================================================ -->
        <!-- Ticket Types (Categories)                                     -->
        <!-- ============================================================ -->
        <record id="ticket_type_keluhan" model="helpdesk.ticket.type">
            <field name="name">Keluhan Produk</field>
        </record>
        <record id="ticket_type_pertanyaan" model="helpdesk.ticket.type">
            <field name="name">Pertanyaan Umum</field>
        </record>
        <record id="ticket_type_pengembalian" model="helpdesk.ticket.type">
            <field name="name">Pengembalian Barang</field>
        </record>
        <record id="ticket_type_pengiriman" model="helpdesk.ticket.type">
            <field name="name">Masalah Pengiriman</field>
        </record>

        <!-- ============================================================ -->
        <!-- Sample Tickets                                                -->
        <!-- ============================================================ -->
        <record id="ticket_sample_1" model="helpdesk.ticket">
            <field name="name">Pelanggan tidak dapat checkout</field>
            <field name="description" type="html"><p>Pelanggan mengalami error 500 saat checkout di marketplace.</p></field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="stage_id" ref="helpdesk.stage_new"/>
            <field name="priority">3</field>
            <field name="ticket_type_id" ref="ticket_type_keluhan"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_pembayaran'), ref('tag_teknis')])]"/>
        </record>

        <record id="ticket_sample_2" model="helpdesk.ticket">
            <field name="name">Pesanan tidak sampai setelah 7 hari</field>
            <field name="description" type="html"><p>Pelanggan sudah menunggu 7 hari kerja namun pesanan belum diterima. Nomor resi menunjukkan status pengiriman macet.</p></field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="stage_id" ref="helpdesk.stage_in_progress"/>
            <field name="priority">2</field>
            <field name="ticket_type_id" ref="ticket_type_pengiriman"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_pengiriman')])]"/>
        </record>

        <record id="ticket_sample_3" model="helpdesk.ticket">
            <field name="name">Produk tidak sesuai deskripsi</field>
            <field name="description" type="html"><p>Pelanggan menerima produk yang berbeda dari deskripsi listing. Meminta pengembalian dana.</p></field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="stage_id" ref="helpdesk.stage_solved"/>
            <field name="priority">1</field>
            <field name="ticket_type_id" ref="ticket_type_pengembalian"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_produk')])]"/>
        </record>

        <record id="ticket_sample_4" model="helpdesk.ticket">
            <field name="name">Gagal reset password akun</field>
            <field name="description" type="html"><p>Pelanggan tidak menerima email reset password. Sudah dicoba beberapa kali.</p></field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="stage_id" ref="helpdesk.stage_new"/>
            <field name="priority">0</field>
            <field name="ticket_type_id" ref="ticket_type_pertanyaan"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_akun'), ref('tag_teknis')])]"/>
        </record>

        <record id="ticket_sample_5" model="helpdesk.ticket">
            <field name="name">Refund belum diproses</field>
            <field name="description" type="html"><p>Pelanggan sudah mengajukan refund 14 hari yang lalu tapi belum ada update. Perlu eskalasi ke tim keuangan.</p></field>
            <field name="team_id" ref="helpdesk_team_dke"/>
            <field name="stage_id" ref="helpdesk.stage_on_hold"/>
            <field name="priority">2</field>
            <field name="ticket_type_id" ref="ticket_type_pengembalian"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_pembayaran')])]"/>
        </record>

    </data>
</odoo>
