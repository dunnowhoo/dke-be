<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Support Ticket Tree View -->
    <record id="dke_support_ticket_view_tree" model="ir.ui.view">
        <field name="name">dke.support.ticket.tree</field>
        <field name="model">dke.support.ticket</field>
        <field name="arch" type="xml">
            <tree string="Support Tickets"
                  decoration-danger="is_overdue == True"
                  decoration-info="state == 'open'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state in ('resolved', 'closed')">
                <field name="name" string="Ref"/>
                <field name="subject" string="Chat Title / Subject"/>
                <field name="topic"/>
                <field name="required_specialization" string="Specialization Needed"/>
                <field name="assigned_expert_id" string="Expert"/>
                <field name="assigned_expert_specialization" string="Expert's Spec." optional="show"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('resolved', 'closed')"/>
                <field name="is_overdue" optional="show"/>
                <field name="resolution_time_hours" string="Res. Time (h)" optional="show"/>
                <field name="message_count" string="Chat Msgs" optional="show"/>
                <field name="create_date" string="Created"/>
                <field name="room_id" invisible="1"/>
                <button name="action_open_chat" type="object" string="Open Chat"
                        icon="fa-comments" invisible="room_id == False"/>
            </tree>
        </field>
    </record>

    <!-- Support Ticket Form View -->
    <record id="dke_support_ticket_view_form" model="ir.ui.view">
        <field name="name">dke.support.ticket.form</field>
        <field name="model">dke.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_mark_in_progress" type="object"
                            string="In Progress" class="btn-primary"
                            invisible="state not in ['open']"/>
                    <button name="action_resolve" type="object"
                            string="Resolve" class="btn-success"
                            invisible="state not in ['in_progress']"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-secondary"
                            invisible="state not in ['resolved']"/>
                    <button name="action_open_chat" type="object"
                            string="Open Chat" class="btn-info"
                            invisible="room_id == False"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Ticket Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="subject" string="Chat Title / Subject"/>
                        <h2><field name="subject"/></h2>
                    </div>
                    <group>
                        <group string="Ticket Info">
                            <field name="topic"/>
                            <field name="required_specialization"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="customer_id"/>
                            <field name="room_id" string="Linked Chat Room"/>
                        </group>
                        <group string="Assignment">
                            <field name="created_by_id" readonly="1"/>
                            <field name="assigned_expert_id"
                                   domain="[('dke_role', '=', 'expert_staff')]"
                                   options="{'no_create': True}"/>
                            <field name="assigned_expert_specialization" readonly="1" string="Expert Specialization"/>
                            <field name="assigned_expert_name" readonly="1" string="Expert Name"/>
                            <field name="sla_deadline"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1" placeholder="Deskripsi masalah pelanggan..."/>
                        </page>
                        <page string="Internal Messages">
                            <field name="ticket_message_ids">
                                <tree editable="bottom">
                                    <field name="sender_id" readonly="1"/>
                                    <field name="content"/>
                                    <field name="created_at" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Performance Metrics">
                            <group>
                                <field name="resolution_time_hours" string="Resolution Time (hours)" readonly="1"/>
                                <field name="message_count" string="Total Chat Messages" readonly="1"/>
                                <field name="first_response_at" readonly="1"/>
                                <field name="resolved_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Support Ticket Search View -->
    <record id="dke_support_ticket_view_search" model="ir.ui.view">
        <field name="name">dke.support.ticket.search</field>
        <field name="model">dke.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="name" string="Ticket Ref"/>
                <field name="subject" string="Title/Subject"/>
                <field name="customer_id"/>
                <field name="assigned_expert_id"/>
                <!-- Status filters -->
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="resolved" string="Resolved" domain="[('state', 'in', ('resolved', 'closed'))]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <!-- Priority filters -->
                <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <filter name="high" string="High Priority" domain="[('priority', '=', 'high')]"/>
                <filter name="medium" string="Medium Priority" domain="[('priority', '=', 'medium')]"/>
                <filter name="low" string="Low Priority" domain="[('priority', '=', 'low')]"/>
                <separator/>
                <!-- Topic filters -->
                <filter name="product_inquiry" string="Product Inquiry" domain="[('topic', '=', 'product_inquiry')]"/>
                <filter name="order_complaint" string="Order Complaint" domain="[('topic', '=', 'order_complaint')]"/>
                <filter name="return_refund" string="Return/Refund" domain="[('topic', '=', 'return_refund')]"/>
                <filter name="shipment" string="Shipment Issue" domain="[('topic', '=', 'shipment')]"/>
                <filter name="payment" string="Payment Issue" domain="[('topic', '=', 'payment')]"/>
                <separator/>
                <!-- Specialization filters -->
                <filter name="spec_face_wash" string="Face Wash Expert" domain="[('required_specialization', '=', 'face_wash')]"/>
                <filter name="spec_serum" string="Serum Expert" domain="[('required_specialization', '=', 'serum')]"/>
                <filter name="spec_lotion" string="Lotion Expert" domain="[('required_specialization', '=', 'lotion')]"/>
                <filter name="spec_toner" string="Toner Expert" domain="[('required_specialization', '=', 'toner')]"/>
                <group string="Group By">
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_topic" string="Topic" context="{'group_by': 'topic'}"/>
                    <filter name="group_specialization" string="Specialization" context="{'group_by': 'required_specialization'}"/>
                    <filter name="group_expert" string="Expert Staff" context="{'group_by': 'assigned_expert_id'}"/>
                    <filter name="group_created_by" string="Customer Care" context="{'group_by': 'created_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Support Ticket Action -->
    <record id="action_dke_support_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">dke.support.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dke_support_ticket_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada tiket.</p>
            <p>Buat percakapan baru di menu Ticketing Rooms untuk otomatis membuat tiket baru.</p>
        </field>
    </record>

</odoo>
